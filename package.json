{
  "name": "sindulis-cloud-solutions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:emulators": "VITE_USE_EMULATORS=true vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.erp.json",
    "typecheck": "tsc --noEmit -p tsconfig.erp.json",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-sindulis-rules \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage --project demo-sindulis \"node tests/e2e/run.mjs\"",
    "emulators": "firebase emulators:start --project demo-sindulis",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.0"
  }
}
